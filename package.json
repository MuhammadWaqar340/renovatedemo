{
  "name": "renovate-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "demo:chalk": "node scripts/chalk-demo.mjs",
    "deprisk:chalk": "deprisk check chalk --from 4.1.2 --to 5.6.2 --verbose",
    "deprisk:lodash": "deprisk check lodash --from 4.0.0 --to 4.18.1 --verbose",
    "deprisk:date-fns": "deprisk check date-fns --from 2.30.0 --to 4.4.0 --verbose",
    "deprisk:uuid": "deprisk check uuid --from 8.3.2 --to 14.0.1 --verbose",
    "deprisk:zod": "deprisk check zod --from 3.22.4 --to 4.4.3 --verbose",
    "deprisk:query-string": "deprisk check query-string --from 6.14.1 --to 9.4.1 --verbose",
    "deprisk:axios": "deprisk check axios --from 0.21.4 --to 1.18.1 --verbose",
    "deprisk:all": "npm run deprisk:chalk && npm run deprisk:lodash && npm run deprisk:date-fns && npm run deprisk:uuid && npm run deprisk:zod && npm run deprisk:query-string && npm run deprisk:axios"
  },
  "dependencies": {
    "axios": "0.21.4",
    "chalk": "4.1.2",
    "date-fns": "2.30.0",
    "lodash": "4.0.0",
    "query-string": "6.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "8.3.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "deprisk-check": "^0.5.1",
    "oxlint": "1.60.0",
    "vite": "8.0.0"
  }
}
